{
	// Cloudflare Workers 静态资源托管（Workers Static Assets）+ 一个极薄 Worker。
	// 这是站点唯一的发布目标：静态文件由资源绑定直出；/api/feedback、/api/analytics
	// 与诊断端点由 worker.js 接住，其余已知路由直出预渲染 HTML，未知路径返回
	// 404.html + HTTP 404。文档：
	//   https://developers.cloudflare.com/workers/static-assets/binding/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dpmaster",
	// 只走自定义域名，不暴露 *.workers.dev 入口。
	"workers_dev": false,
	// 不为部署版本生成 Cloudflare Preview URLs。
	"preview_urls": false,
	"routes": [
		{
			"pattern": "dp.round1.cc",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
			"zone_name": "round1.cc"
		}
	],
	"compatibility_date": "2026-07-06",
	// Worker 入口：先接同源 API，其余交回 env.ASSETS（见 worker.js）。
	"main": "worker.js",
	"vars": {
		"FEEDBACK_WEBHOOK_KIND": "dingtalk",
		"ALERT_WEBHOOK_KIND": "dingtalk"
	},
	// Webhook URL / secret / 诊断密钥在 Cloudflare Dashboard 配置；部署时保留这些变量。
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			// 1 = 100% 采样；如果流量变大，可降到 0.1 或 0.01。
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": false
		}
	},
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "dpmaster"
		}
	],
	"assets": {
		"directory": "./dist/",
		// 让 Worker 能通过 env.ASSETS.fetch() 取静态资源和 404 页面。
		"binding": "ASSETS",
		// 已知路由由预渲染的 .html 文件直出；未知路径返回 404.html + HTTP 404。
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	}
}
