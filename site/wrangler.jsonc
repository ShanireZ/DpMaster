{
	// Cloudflare Workers 靜態資源託管（Workers Static Assets）+ 一個極薄 Worker。
	// 這是站台唯一的發佈目標：所有請求先經過 worker.js，API 由 Worker 處理，
	// 公開路由再從資源綁定讀取預繪製 HTML 或協商後的 Markdown；未知路徑回傳
	// 404.html + HTTP 404，內部表示路徑固定隱藏。文件：
	//   https://developers.cloudflare.com/workers/static-assets/binding/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dpmaster",
	// 只走自訂網域，不暴露 *.workers.dev 入口。
	"workers_dev": false,
	// 不為部署版本生成 Cloudflare Preview URLs。
	"preview_urls": false,
	"routes": [
		{
			"pattern": "dp.round1.cc",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
			"zone_name": "round1.cc"
		}
	],
	// 2026-08-04 起 nodejs_compat / nodejs_compat_v2 預設開啟。本 Worker 不 import
	// 任何 node: 模組，因此這個日期對現有程式碼是零行為變化，只是不再落後。
	// ★ 不啟用 Smart Placement：本 Worker ~100% 的請求是 env.ASSETS 靜態直出，
	// 沒有需要靠近的後端；把執行點從訪客身邊挪走只會給每次 HTML 請求加一跳。
	"compatibility_date": "2026-08-04",
	// Worker 入口：先接同源 API，其餘交回 env.ASSETS（見 worker.js）。
	"main": "worker.js",
	"vars": {
		"FEEDBACK_WEBHOOK_KIND": "dingtalk",
		"ALERT_WEBHOOK_KIND": "dingtalk"
	},
	// Webhook URL / secret / 診斷金鑰在 Cloudflare Dashboard 設定；部署時保留這些變數。
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			// 1 = 100% 取樣；如果流量變大，可降到 0.1 或 0.01。
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": false
		}
	},
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "dpmaster"
		}
	],
	"assets": {
		"directory": "./dist/",
		// 讓 Worker 能通過 env.ASSETS.fetch() 取靜態資源和 404 頁面。
		"binding": "ASSETS",
		// Cloudflare 預設資產優先會繞過內容協商與內部路徑保護；必須先執行 Worker。
		"run_worker_first": true,
		// Worker 讀取已知預繪製路線；未知路徑回傳 404.html + HTTP 404。
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	}
}
